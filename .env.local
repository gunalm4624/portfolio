# Required to email you when someone submits the contact form.
# Create at https://resend.com/api-keys (free tier is plenty for a contact form).
RESEND_API_KEY=re_G2GFhXpF_EAMKGMRN77a6TcV46hacNG85

# Sender address. "onboarding@resend.dev" works immediately with no setup, but
# Resend only lets it deliver to LEAD_NOTIFICATION_EMAIL below (your own inbox) —
